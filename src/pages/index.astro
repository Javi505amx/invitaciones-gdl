---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Benefits from '../components/Benefits.astro';
import Portfolio from '../components/Portfolio.astro';
import Pricing from '../components/Pricing.astro';
import Process from '../components/Process.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';

const title = 'Invitaciones Web Digitales e Interactivas | EventosWeb';
const description = 'Crea hermosas invitaciones digitales para bodas, XV años y aniversarios con confirmación automática, mapas interactivos y más.';
---

<Layout title={title} description={description}>
  <Header />
  <main>
    <Hero />
    <Benefits />
    <Portfolio />
    <Pricing />
    <Process />
    <FAQ />
  </main>
  <Footer />
</Layout>